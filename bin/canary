#!/usr/bin/env bash
# shellcheck disable=SC2088  # Tilde in quotes is intentional — display strings, not path expansion
set -euo pipefail

# fledge-plugin-canary — first-party security audit tool
# Probes plugin capability boundaries and reports what leaks.
# Run: fledge canary [--section metadata|exec|store|all]

PASS=0
FAIL=0
WARN=0
ID=0
IN_BOUNDARY_TEST=0

send() { echo "$1"; }
recv() { read -r line; echo "$line"; }
next_id() { ID=$((ID + 1)); echo "$ID"; }

# If fledge kills us during a boundary test, that IS the pass
trap 'if [ $IN_BOUNDARY_TEST -eq 1 ]; then exit 0; fi' EXIT PIPE

pass() { PASS=$((PASS + 1)); send "{\"type\":\"output\",\"text\":\"  \\u2713 PASS: $1\\n\"}"; }
fail() { FAIL=$((FAIL + 1)); send "{\"type\":\"output\",\"text\":\"  \\u2717 FAIL: $1\\n\"}"; }
warn() { WARN=$((WARN + 1)); send "{\"type\":\"output\",\"text\":\"  ! WARN: $1\\n\"}"; }
header() { send "{\"type\":\"output\",\"text\":\"\\n=== $1 ===\\n\"}"; }

# ── Init ──────────────────────────────────────────────────────────────
INIT=$(recv)
CAPS=$(echo "$INIT" | jq -r '.capabilities')
HAS_EXEC=$(echo "$CAPS" | jq -r '.exec // false')
HAS_STORE=$(echo "$CAPS" | jq -r '.store // false')
HAS_METADATA=$(echo "$CAPS" | jq -r '.metadata // false')

SECTION="all"
ARGS=$(echo "$INIT" | jq -r '.args[0] // ""')
case "$ARGS" in
  metadata|exec|store|expose|baseline) SECTION="$ARGS" ;;
  *) SECTION="all" ;;
esac

VERSION=$(echo "$INIT" | jq -r '.plugin.version // "unknown"')
send "{\"type\":\"output\",\"text\":\"fledge-plugin-canary v$VERSION\\n\"}"
send "{\"type\":\"output\",\"text\":\"Capabilities granted: exec=$HAS_EXEC store=$HAS_STORE metadata=$HAS_METADATA\\n\"}"
send "{\"type\":\"output\",\"text\":\"Running section: $SECTION\\n\"}"

# ── Metadata Tests ────────────────────────────────────────────────────
run_metadata_tests() {
  header "METADATA CAPABILITY TESTS"

  if [ "$HAS_METADATA" != "true" ]; then
    send "{\"type\":\"output\",\"text\":\"  (metadata not granted — testing denial)\\n\"}"
  fi

  # Test 1: Can we read fledge_config?
  mid=$(next_id)
  send "{\"type\":\"metadata\",\"id\":\"$mid\",\"keys\":[\"fledge_config\"]}"
  resp=$(recv)
  val=$(echo "$resp" | jq -r '.value.fledge_config // empty')
  if [ "$HAS_METADATA" = "true" ]; then
    if [ -n "$val" ] && [ "$val" != "null" ]; then
      pass "fledge_config readable (expected with metadata cap)"
      # Check if anything secret-looking is in there
      secrets=$(echo "$val" | jq -r '.. | strings' 2>/dev/null | grep -iE '(token|secret|password|key|credential)' || true)
      if [ -n "$secrets" ]; then
        warn "fledge.toml contains secret-looking values (users should not put secrets here)"
      else
        pass "fledge.toml has no obvious secrets"
      fi
    else
      fail "fledge_config empty despite metadata cap"
    fi
  else
    if [ -z "$val" ] || [ "$val" = "null" ]; then
      pass "fledge_config blocked without metadata cap"
    else
      fail "fledge_config readable WITHOUT metadata cap — data leaked"
    fi
  fi

  # Test 2: Env var filtering
  mid=$(next_id)
  send "{\"type\":\"metadata\",\"id\":\"$mid\",\"keys\":[\"env\"]}"
  resp=$(recv)
  env_obj=$(echo "$resp" | jq -r '.value.env // {}')

  if [ "$HAS_METADATA" = "true" ]; then
    # Check for sensitive patterns that should be filtered
    leaked=""
    for pattern in GITHUB_TOKEN AWS_SECRET_ACCESS_KEY OPENAI_API_KEY ANTHROPIC_API_KEY DATABASE_URL FLEDGE_GITHUB_TOKEN; do
      val=$(echo "$env_obj" | jq -r ".[\"$pattern\"] // empty")
      if [ -n "$val" ]; then
        leaked="$leaked $pattern"
      fi
    done

    if [ -n "$leaked" ]; then
      fail "Sensitive env vars leaked through metadata:$leaked"
    else
      pass "Common sensitive env var patterns filtered"
    fi

    # Count what IS visible
    env_count=$(echo "$env_obj" | jq 'length')
    send "{\"type\":\"output\",\"text\":\"  (env vars visible via metadata: $env_count)\\n\"}"

    # List any vars containing 'key', 'token', 'secret', 'password' in their names
    suspicious=$(echo "$env_obj" | jq -r 'keys[]' | grep -iE '(token|secret|password|credential|apikey)' || true)
    if [ -n "$suspicious" ]; then
      warn "Vars with sensitive-sounding names passed filter: $suspicious"
    else
      pass "No sensitive-sounding var names passed filter"
    fi
  else
    env_count=$(echo "$env_obj" | jq 'length' 2>/dev/null || echo "0")
    if [ "$env_count" = "0" ]; then
      pass "Env vars blocked without metadata cap"
    else
      fail "Env vars readable WITHOUT metadata cap — $env_count vars leaked"
    fi
  fi

  # Test 3: Git info access
  mid=$(next_id)
  send "{\"type\":\"metadata\",\"id\":\"$mid\",\"keys\":[\"git_status\",\"git_log\",\"git_tags\"]}"
  resp=$(recv)
  git_status=$(echo "$resp" | jq -r '.value.git_status // empty')
  git_log=$(echo "$resp" | jq -r '.value.git_log // empty')

  if [ "$HAS_METADATA" = "true" ]; then
    if [ -n "$git_status" ] || [ -n "$git_log" ]; then
      pass "Git metadata accessible (expected with metadata cap)"
    else
      warn "Git metadata empty — might not be in a git repo"
    fi
  else
    if [ -z "$git_status" ] && [ -z "$git_log" ]; then
      pass "Git metadata blocked without metadata cap"
    else
      fail "Git metadata readable WITHOUT metadata cap"
    fi
  fi
}

# ── Exec Tests ────────────────────────────────────────────────────────
run_exec_tests() {
  header "EXEC CAPABILITY TESTS"

  if [ "$HAS_EXEC" != "true" ]; then
    send "{\"type\":\"output\",\"text\":\"  (exec not granted — testing denial)\\n\"}"
  fi

  # Test 1: Basic exec works
  mid=$(next_id)
  send "{\"type\":\"exec\",\"id\":\"$mid\",\"command\":\"echo canary-test\"}"
  resp=$(recv)
  code=$(echo "$resp" | jq -r '.value.code // 126')
  stdout=$(echo "$resp" | jq -r '.value.stdout // empty')

  if [ "$HAS_EXEC" = "true" ]; then
    if [ "$code" = "0" ] && echo "$stdout" | grep -q "canary-test"; then
      pass "Basic exec works"
    elif [ "$code" = "126" ]; then
      fail "Exec blocked despite having exec cap"
    else
      fail "Exec returned unexpected code=$code"
    fi
  else
    if [ "$code" = "126" ]; then
      pass "Exec blocked without exec cap (code 126)"
    else
      fail "Exec succeeded WITHOUT exec cap — command ran"
    fi
  fi

  # Only run remaining exec tests if we have the capability
  if [ "$HAS_EXEC" != "true" ]; then
    return
  fi

  # Test 2: Can we read global config?
  mid=$(next_id)
  send "{\"type\":\"exec\",\"id\":\"$mid\",\"command\":\"cat ~/.config/fledge/config.toml 2>/dev/null || echo __NOT_FOUND__\"}"
  resp=$(recv)
  stdout=$(echo "$resp" | jq -r '.value.stdout // empty')

  if echo "$stdout" | grep -q "__NOT_FOUND__"; then
    pass "Global config not found (or doesn't exist)"
  elif echo "$stdout" | grep -qiE '(github_token|token|api_key)'; then
    warn "Global config readable via exec AND contains token-like values"
    send "{\"type\":\"output\",\"text\":\"  (This is expected — exec = full shell access. Document this clearly.)\\n\"}"
  elif [ -n "$stdout" ]; then
    warn "Global config readable via exec (expected — exec = shell access)"
  fi

  # Test 3: Can we escape cwd?
  mid=$(next_id)
  send "{\"type\":\"exec\",\"id\":\"$mid\",\"command\":\"ls /etc/hosts\"}"
  resp=$(recv)
  code=$(echo "$resp" | jq -r '.value.code // 126')
  if [ "$code" = "0" ]; then
    warn "Can access files outside project root via exec (expected — exec = shell access)"
  else
    pass "File access outside project root blocked"
  fi

  # Test 4: cwd traversal via the cwd parameter
  mid=$(next_id)
  send "{\"type\":\"exec\",\"id\":\"$mid\",\"command\":\"pwd\",\"cwd\":\"../../..\"}"
  resp=$(recv)
  code=$(echo "$resp" | jq -r '.value.code // 126')
  stdout=$(echo "$resp" | jq -r '.value.stdout // empty' | tr -d '[:space:]')

  if [ "$code" = "126" ] || [ "$code" = "1" ]; then
    pass "cwd traversal (../../..) blocked"
  else
    # Check if the resolved path is still under project root
    project_root=$(echo "$INIT" | jq -r '.project.root // ""')
    if [ -n "$project_root" ] && echo "$stdout" | grep -q "^$project_root"; then
      pass "cwd traversal resolved within project root (canonicalize works)"
    else
      warn "cwd traversal resolved to: $stdout (may be outside project root)"
    fi
  fi

  # Test 5: Env var access via exec
  mid=$(next_id)
  send "{\"type\":\"exec\",\"id\":\"$mid\",\"command\":\"env | grep -iE '(TOKEN|SECRET|KEY|PASSWORD|CREDENTIAL)' | head -20 || echo __NONE__\"}"
  resp=$(recv)
  stdout=$(echo "$resp" | jq -r '.value.stdout // empty')

  if echo "$stdout" | grep -q "__NONE__"; then
    pass "No sensitive-looking env vars visible via exec"
  elif [ -n "$stdout" ]; then
    count=$(echo "$stdout" | wc -l | tr -d ' ')
    warn "Exec env has $count sensitive-looking vars (expected — exec inherits shell env)"
    send "{\"type\":\"output\",\"text\":\"  Visible sensitive vars:\\n\"}"
    while IFS= read -r line; do
      varname=$(echo "$line" | cut -d= -f1)
      send "{\"type\":\"output\",\"text\":\"    - $varname\\n\"}"
    done <<< "$stdout"
  fi

  # Test 6: Can we write to the plugin directory?
  mid=$(next_id)
  send "{\"type\":\"exec\",\"id\":\"$mid\",\"command\":\"touch /tmp/canary-write-test && rm /tmp/canary-write-test && echo __OK__\"}"
  resp=$(recv)
  stdout=$(echo "$resp" | jq -r '.value.stdout // empty')
  if echo "$stdout" | grep -q "__OK__"; then
    warn "Can write to /tmp via exec (expected — exec = shell access)"
  fi
}

# ── Store Tests ───────────────────────────────────────────────────────
run_store_tests() {
  header "STORE CAPABILITY TESTS"

  if [ "$HAS_STORE" != "true" ]; then
    send "{\"type\":\"output\",\"text\":\"  (store not granted — testing denial)\\n\"}"
  fi

  # Test 1: Basic store/load cycle
  mid=$(next_id)
  send "{\"type\":\"store\",\"key\":\"canary_test\",\"value\":\"hello\"}"
  # store is fire-and-forget, no response

  mid=$(next_id)
  send "{\"type\":\"load\",\"id\":\"$mid\",\"key\":\"canary_test\"}"
  resp=$(recv)
  val=$(echo "$resp" | jq -r '.value // empty')

  if [ "$HAS_STORE" = "true" ]; then
    if [ "$val" = "hello" ]; then
      pass "Store/load cycle works"
    elif [ -z "$val" ] || [ "$val" = "null" ]; then
      fail "Store/load failed — value not persisted"
    fi
  else
    if [ -z "$val" ] || [ "$val" = "null" ]; then
      pass "Store blocked without store cap (load returns null)"
    else
      fail "Store readable WITHOUT store cap — data leaked"
    fi
  fi

  # Only run remaining store tests if we have the capability
  if [ "$HAS_STORE" != "true" ]; then
    return
  fi

  # Test 2: Key length boundary (256 bytes max)
  # fledge may terminate the plugin on boundary violations, so disable errexit
  long_key=$(printf 'x%.0s' $(seq 1 257))
  IN_BOUNDARY_TEST=1
  set +e
  send "{\"type\":\"store\",\"key\":\"$long_key\",\"value\":\"test\"}" 2>/dev/null
  mid=$(next_id)
  send "{\"type\":\"load\",\"id\":\"$mid\",\"key\":\"$long_key\"}" 2>/dev/null
  resp=$(recv 2>/dev/null)
  store_exit=$?
  set -e

  IN_BOUNDARY_TEST=0
  if [ $store_exit -ne 0 ]; then
    # Pipe closed = fledge terminated us for the violation — boundary enforced
    pass "Oversized key (257 bytes) rejected (process terminated)"
  else
    val=$(echo "$resp" | jq -r '.value // empty')
    if [ -z "$val" ] || [ "$val" = "null" ]; then
      pass "Oversized key (257 bytes) rejected"
    else
      fail "Oversized key (257 bytes) accepted — boundary not enforced"
    fi
  fi

  # Test 3: Value size boundary (64 KB max)
  # Same pattern — fledge may terminate on oversized values
  big_value=$(printf 'x%.0s' $(seq 1 65537))
  IN_BOUNDARY_TEST=1
  set +e
  send "{\"type\":\"store\",\"key\":\"canary_big\",\"value\":\"$big_value\"}" 2>/dev/null
  mid=$(next_id)
  send "{\"type\":\"load\",\"id\":\"$mid\",\"key\":\"canary_big\"}" 2>/dev/null
  resp=$(recv 2>/dev/null)
  store_exit=$?
  set -e

  IN_BOUNDARY_TEST=0
  if [ $store_exit -ne 0 ]; then
    pass "Oversized value (65537 bytes) rejected (process terminated)"
  else
    val=$(echo "$resp" | jq -r '.value // empty')
    if [ -z "$val" ] || [ "$val" = "null" ]; then
      pass "Oversized value (65537 bytes) rejected"
    else
      val_len=${#val}
      if [ "$val_len" -le 65536 ]; then
        warn "Oversized value stored but truncated to $val_len bytes"
      else
        fail "Oversized value (65537 bytes) accepted without truncation"
      fi
    fi
  fi

  # Cleanup test keys
  send "{\"type\":\"store\",\"key\":\"canary_test\",\"value\":\"\"}" 2>/dev/null
  send "{\"type\":\"store\",\"key\":\"canary_big\",\"value\":\"\"}" 2>/dev/null
}

# ── Exposure Report ───────────────────────────────────────────────────
run_exposure_report() {
  header "EXPOSURE REPORT — What a malicious plugin can access"
  send "{\"type\":\"output\",\"text\":\"  This shows exactly what data each capability exposes.\\n\"}"
  send "{\"type\":\"output\",\"text\":\"  A real attack would exfiltrate these via exec (curl/dns/etc).\\n\\n\"}"

  # ── Config exposure via metadata ──
  if [ "$HAS_METADATA" = "true" ]; then
    send "{\"type\":\"output\",\"text\":\"  ── Via METADATA capability ──\\n\"}"

    # fledge.toml contents
    mid=$(next_id)
    send "{\"type\":\"metadata\",\"id\":\"$mid\",\"keys\":[\"fledge_config\"]}"
    resp=$(recv)
    config=$(echo "$resp" | jq -r '.value.fledge_config // empty')
    if [ -n "$config" ] && [ "$config" != "null" ]; then
      send "{\"type\":\"output\",\"text\":\"  [fledge.toml] Full project config readable:\\n\"}"
      # Show keys/structure without full values (truncate long values)
      echo "$config" | jq -r 'paths(scalars) as $p | "    " + ($p | join(".")) + " = " + (getpath($p) | tostring | if length > 40 then .[:37] + "..." else . end)' 2>/dev/null | while IFS= read -r line; do
        send "{\"type\":\"output\",\"text\":\"$line\\n\"}"
      done
    fi

    # Env vars visible
    mid=$(next_id)
    send "{\"type\":\"metadata\",\"id\":\"$mid\",\"keys\":[\"env\"]}"
    resp=$(recv)
    env_obj=$(echo "$resp" | jq -r '.value.env // {}')
    env_count=$(echo "$env_obj" | jq 'length')
    send "{\"type\":\"output\",\"text\":\"\\n  [env vars] $env_count vars accessible via metadata RPC:\\n\"}"
    echo "$env_obj" | jq -r 'keys[]' | sort | while IFS= read -r varname; do
      val=$(echo "$env_obj" | jq -r ".[\"$varname\"]")
      masked="${val:0:3}***${val: -2}"
      if [ ${#val} -le 5 ]; then
        masked="[${#val} chars]"
      fi
      send "{\"type\":\"output\",\"text\":\"    $varname = $masked\\n\"}"
    done
  fi

  # ── Config exposure via exec ──
  if [ "$HAS_EXEC" = "true" ]; then
    send "{\"type\":\"output\",\"text\":\"\\n  ── Via EXEC capability ──\\n\"}"
    send "{\"type\":\"output\",\"text\":\"  (exec = full shell — can read ANY file the user can read)\\n\\n\"}"

    # Try global config
    mid=$(next_id)
    send "{\"type\":\"exec\",\"id\":\"$mid\",\"command\":\"cat ~/.config/fledge/config.toml 2>/dev/null || echo __NONE__\"}"
    resp=$(recv)
    stdout=$(echo "$resp" | jq -r '.value.stdout // empty')
    if echo "$stdout" | grep -q "__NONE__"; then
      send "{\"type\":\"output\",\"text\":\"  [~/.config/fledge/config.toml] Not found\\n\"}"
    else
      send "{\"type\":\"output\",\"text\":\"  [~/.config/fledge/config.toml] READABLE — contents:\\n\"}"
      echo "$stdout" | while IFS= read -r line; do
        # Mask values that look like tokens
        masked_line=$(echo "$line" | sed -E 's/(=\s*"?)([^"]{4})[^"]*([^"]{2}("?))/\1\2***\3/g')
        send "{\"type\":\"output\",\"text\":\"    $masked_line\\n\"}"
      done
    fi

    # Try SSH keys
    mid=$(next_id)
    send "{\"type\":\"exec\",\"id\":\"$mid\",\"command\":\"ls ~/.ssh/ 2>/dev/null || echo __NONE__\"}"
    resp=$(recv)
    stdout=$(echo "$resp" | jq -r '.value.stdout // empty')
    if echo "$stdout" | grep -q "__NONE__"; then
      send "{\"type\":\"output\",\"text\":\"\\n  [~/.ssh/] Not accessible\\n\"}"
    else
      send "{\"type\":\"output\",\"text\":\"\\n  [~/.ssh/] Directory listable: $stdout\\n\"}"
    fi

    # Try all env vars (unfiltered via shell)
    mid=$(next_id)
    send "{\"type\":\"exec\",\"id\":\"$mid\",\"command\":\"env | grep -iE '(TOKEN|SECRET|KEY|PASSWORD|CREDENTIAL|API|AUTH)' | sed -E 's/(=.{4}).*/=\\1***/' | sort\"}"
    resp=$(recv)
    stdout=$(echo "$resp" | jq -r '.value.stdout // empty')
    if [ -n "$stdout" ]; then
      send "{\"type\":\"output\",\"text\":\"\\n  [env via shell] Sensitive-looking vars (masked):\\n\"}"
      echo "$stdout" | while IFS= read -r line; do
        send "{\"type\":\"output\",\"text\":\"    $line\\n\"}"
      done
    else
      send "{\"type\":\"output\",\"text\":\"\\n  [env via shell] No sensitive-pattern vars found\\n\"}"
    fi

    # Try git credentials
    mid=$(next_id)
    send "{\"type\":\"exec\",\"id\":\"$mid\",\"command\":\"git config --global --list 2>/dev/null | grep -iE '(token|credential|password|oauth)' | sed -E 's/(=.{4}).*/=\\1***/' || echo __NONE__\"}"
    resp=$(recv)
    stdout=$(echo "$resp" | jq -r '.value.stdout // empty')
    if echo "$stdout" | grep -q "__NONE__" || [ -z "$stdout" ]; then
      send "{\"type\":\"output\",\"text\":\"\\n  [git config] No credential-like entries\\n\"}"
    else
      send "{\"type\":\"output\",\"text\":\"\\n  [git config] Credential-like entries (masked):\\n\"}"
      echo "$stdout" | while IFS= read -r line; do
        send "{\"type\":\"output\",\"text\":\"    $line\\n\"}"
      done
    fi
  fi

  if [ "$HAS_METADATA" != "true" ] && [ "$HAS_EXEC" != "true" ]; then
    send "{\"type\":\"output\",\"text\":\"  No metadata or exec capability — minimal exposure.\\n\"}"
    send "{\"type\":\"output\",\"text\":\"  Only store is available (isolated key-value, no secrets access).\\n\"}"
  fi

  send "{\"type\":\"output\",\"text\":\"\\n  ── Attack vector summary ──\\n\"}"
  send "{\"type\":\"output\",\"text\":\"  A malicious plugin with exec could:\\n\"}"
  send "{\"type\":\"output\",\"text\":\"    • Read ~/.config/fledge/config.toml (GitHub token, LLM keys)\\n\"}"
  send "{\"type\":\"output\",\"text\":\"    • Read SSH keys, browser cookies, cloud credentials\\n\"}"
  send "{\"type\":\"output\",\"text\":\"    • Exfiltrate via: curl, dns tunneling, git push to attacker repo\\n\"}"
  send "{\"type\":\"output\",\"text\":\"    • Persist via: crontab, shell rc files, git hooks\\n\"}"
  send "{\"type\":\"output\",\"text\":\"    • Worm via: modify other installed plugins, inject into project\\n\"}"
  send "{\"type\":\"output\",\"text\":\"\\n  BOTTOM LINE: exec = full user access. Only install trusted plugins.\\n\"}"
}

# ── Baseline Tests (no RPC, direct process access) ───────────────────
run_baseline_tests() {
  header "BASELINE TESTS — What ANY plugin gets without capabilities"
  send "{\"type\":\"output\",\"text\":\"  These tests use direct bash access, NOT the fledge-v1 RPC.\\n\"}"
  send "{\"type\":\"output\",\"text\":\"  Capabilities only gate protocol responses — the process itself is unsandboxed.\\n\\n\"}"

  # Test 1: Init message leaks project context
  project_name=$(echo "$INIT" | jq -r '.project.name // empty')
  project_root=$(echo "$INIT" | jq -r '.project.root // empty')
  git_branch=$(echo "$INIT" | jq -r '.project.git.branch // empty')
  git_remote=$(echo "$INIT" | jq -r '.project.git.remote_url // empty')

  send "{\"type\":\"output\",\"text\":\"  ── Init message data (always sent, no capability needed) ──\\n\"}"
  if [ -n "$project_name" ]; then
    send "{\"type\":\"output\",\"text\":\"    project.name   = $project_name\\n\"}"
  fi
  if [ -n "$project_root" ]; then
    send "{\"type\":\"output\",\"text\":\"    project.root   = $project_root\\n\"}"
    pass "Init message exposes project root path"
  else
    pass "No project root in init (unexpected)"
  fi
  if [ -n "$git_branch" ]; then
    send "{\"type\":\"output\",\"text\":\"    git.branch     = $git_branch\\n\"}"
  fi
  if [ -n "$git_remote" ]; then
    send "{\"type\":\"output\",\"text\":\"    git.remote_url = $git_remote\\n\"}"
  fi

  # Test 2: Direct env var access (no exec RPC needed)
  send "{\"type\":\"output\",\"text\":\"\\n  ── Direct env var access (inherited from parent shell) ──\\n\"}"
  sensitive_count=0
  for varname in GITHUB_TOKEN GH_TOKEN OPENAI_API_KEY ANTHROPIC_API_KEY AWS_SECRET_ACCESS_KEY AWS_ACCESS_KEY_ID DATABASE_URL FLEDGE_GITHUB_TOKEN NPM_TOKEN DOCKER_PASSWORD; do
    val="${!varname:-}"
    if [ -n "$val" ]; then
      masked="${val:0:3}***"
      send "{\"type\":\"output\",\"text\":\"    $varname = $masked (LEAKED via process env)\\n\"}"
      sensitive_count=$((sensitive_count + 1))
    fi
  done
  if [ "$sensitive_count" -gt 0 ]; then
    fail "Plugin process inherits $sensitive_count sensitive env vars (no capability needed)"
  else
    pass "No common sensitive env vars found in process environment"
  fi

  # Test 3: Direct filesystem access (no exec RPC needed)
  send "{\"type\":\"output\",\"text\":\"\\n  ── Direct filesystem access (bash can read anything user can) ──\\n\"}"

  if [ -r "$HOME/.config/fledge/config.toml" ]; then
    token_lines=$(grep -ciE '(token|secret|key|password)' "$HOME/.config/fledge/config.toml" 2>/dev/null || echo 0)
    fail "~/.config/fledge/config.toml READABLE ($token_lines sensitive-looking lines) — no capability needed"
  else
    pass "~/.config/fledge/config.toml not readable (doesn't exist or no access)"
  fi

  if [ -d "$HOME/.ssh" ]; then
    # shellcheck disable=SC2012
    ssh_files=$(find "$HOME/.ssh/" -maxdepth 1 -printf '%f, ' 2>/dev/null || ls "$HOME/.ssh/" 2>/dev/null | tr '\n' ', ')
    if [ -n "$ssh_files" ]; then
      warn "~/.ssh/ listable: $ssh_files"
    fi
  else
    pass "~/.ssh/ not accessible"
  fi

  if [ -r "fledge.toml" ]; then
    pass "fledge.toml readable (expected — in project directory)"
  fi

  # Test 4: Network access (no exec RPC needed)
  send "{\"type\":\"output\",\"text\":\"\\n  ── Network access ──\\n\"}"
  if command -v curl &>/dev/null; then
    warn "curl available — plugin could exfiltrate data to any endpoint"
  fi
  if command -v wget &>/dev/null; then
    warn "wget available — plugin could exfiltrate data"
  fi

  # Test 5: Can we write to the project directory?
  send "{\"type\":\"output\",\"text\":\"\\n  ── Write access ──\\n\"}"
  test_file=".canary-write-test-$$"
  if [ -n "$project_root" ] && touch "$project_root/$test_file" 2>/dev/null; then
    rm -f "$project_root/$test_file"
    warn "Can write to project root (no capability needed)"
  else
    pass "Cannot write to project root"
  fi

  if touch "/tmp/canary-baseline-$$" 2>/dev/null; then
    rm -f "/tmp/canary-baseline-$$"
    warn "Can write to /tmp (no capability needed)"
  fi

  # Test 6: Credential files (no exec RPC needed)
  send "{\"type\":\"output\",\"text\":\"\\n  ── Credential file access ──\\n\"}"
  cred_count=0

  # AWS
  if [ -r "$HOME/.aws/credentials" ]; then
    warn "~/.aws/credentials READABLE — AWS keys exposed"
    cred_count=$((cred_count + 1))
  fi
  if [ -r "$HOME/.aws/config" ]; then
    warn "~/.aws/config READABLE — AWS account/region info exposed"
    cred_count=$((cred_count + 1))
  fi

  # Docker
  if [ -r "$HOME/.docker/config.json" ]; then
    has_auth=$(grep -c '"auth"' "$HOME/.docker/config.json" 2>/dev/null) || has_auth=0
    if [ "$has_auth" -gt 0 ]; then
      warn "~/.docker/config.json READABLE with $has_auth auth entries"
    else
      send "{\"type\":\"output\",\"text\":\"  ✓ ~/.docker/config.json readable but no auth entries\\n\"}"
    fi
    cred_count=$((cred_count + 1))
  fi

  # Kubernetes
  if [ -r "$HOME/.kube/config" ]; then
    warn "~/.kube/config READABLE — cluster credentials exposed"
    cred_count=$((cred_count + 1))
  fi

  # npm
  if [ -r "$HOME/.npmrc" ]; then
    has_token=$(grep -ciE '(token|_auth)' "$HOME/.npmrc" 2>/dev/null) || has_token=0
    if [ "$has_token" -gt 0 ]; then
      warn "~/.npmrc READABLE with $has_token token/auth lines"
    else
      send "{\"type\":\"output\",\"text\":\"  ✓ ~/.npmrc readable but no tokens\\n\"}"
    fi
    cred_count=$((cred_count + 1))
  fi

  # .netrc (often has GitHub tokens)
  if [ -r "$HOME/.netrc" ]; then
    warn "~/.netrc READABLE — may contain GitHub/API passwords"
    cred_count=$((cred_count + 1))
  fi

  # GitHub CLI
  if [ -r "$HOME/.config/gh/hosts.yml" ]; then
    warn "~/.config/gh/hosts.yml READABLE — GitHub CLI oauth token exposed"
    cred_count=$((cred_count + 1))
  fi

  # Git credentials file
  if [ -r "$HOME/.git-credentials" ]; then
    warn "~/.git-credentials READABLE — plaintext Git passwords"
    cred_count=$((cred_count + 1))
  fi

  # GPG
  if [ -d "$HOME/.gnupg" ] && ls "$HOME/.gnupg/" &>/dev/null; then
    warn "~/.gnupg/ listable — GPG keyring accessible"
    cred_count=$((cred_count + 1))
  fi

  # Project .env files
  for envfile in .env .env.local .env.production .env.development; do
    if [ -r "$envfile" ]; then
      secret_lines=$(grep -ciE '(token|secret|key|password|credential|api)' "$envfile" 2>/dev/null) || secret_lines=0
      warn "$envfile READABLE ($secret_lines sensitive-looking lines)"
      cred_count=$((cred_count + 1))
    fi
  done

  if [ "$cred_count" -eq 0 ]; then
    pass "No common credential files found readable"
  else
    send "{\"type\":\"output\",\"text\":\"  ($cred_count credential sources accessible — no capability needed)\\n\"}"
  fi

  # Test 7: Shell history (often contains pasted secrets/tokens)
  send "{\"type\":\"output\",\"text\":\"\\n  ── Shell history ──\\n\"}"
  history_found=0
  for histfile in "$HOME/.zsh_history" "$HOME/.bash_history" "$HOME/.local/share/fish/fish_history"; do
    if [ -r "$histfile" ]; then
      lines=$(wc -l < "$histfile" 2>/dev/null | tr -d ' ')
      secret_hits=$(grep -ciE '(token|secret|password|apikey|bearer)' "$histfile" 2>/dev/null) || secret_hits=0
      basename=$(basename "$histfile")
      warn "~/$basename READABLE ($lines lines, $secret_hits secret-pattern matches)"
      history_found=$((history_found + 1))
    fi
  done
  if [ "$history_found" -eq 0 ]; then
    pass "No shell history files readable"
  fi

  # Test 8: Clipboard (macOS)
  send "{\"type\":\"output\",\"text\":\"\\n  ── Clipboard access ──\\n\"}"
  if command -v pbpaste &>/dev/null; then
    clip_len=$(pbpaste 2>/dev/null | wc -c | tr -d ' ')
    if [ "$clip_len" -gt 0 ]; then
      warn "pbpaste accessible — clipboard has $clip_len bytes (could contain passwords)"
    else
      pass "Clipboard empty"
    fi
  else
    pass "pbpaste not available (not macOS or not installed)"
  fi

  # Test 9: Persistence vectors
  send "{\"type\":\"output\",\"text\":\"\\n  ── Persistence vectors (can a plugin backdoor you?) ──\\n\"}"
  persist_count=0

  # Git hooks
  if [ -d ".git/hooks" ] && [ -w ".git/hooks" ]; then
    warn ".git/hooks/ writable — can inject code into git commit/push/merge"
    persist_count=$((persist_count + 1))
  fi

  # Shell RC files
  for rcfile in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.bash_profile" "$HOME/.zprofile"; do
    if [ -w "$rcfile" ]; then
      basename=$(basename "$rcfile")
      warn "~/$basename writable — can backdoor shell startup"
      persist_count=$((persist_count + 1))
      break  # one is enough to prove the point
    fi
  done

  # macOS LaunchAgents
  if [ -d "$HOME/Library/LaunchAgents" ] && [ -w "$HOME/Library/LaunchAgents" ]; then
    warn "~/Library/LaunchAgents/ writable — can install persistent macOS daemon"
    persist_count=$((persist_count + 1))
  fi

  # Crontab
  if command -v crontab &>/dev/null; then
    warn "crontab available — can schedule persistent exfiltration"
    persist_count=$((persist_count + 1))
  fi

  if [ "$persist_count" -eq 0 ]; then
    pass "No persistence vectors found"
  else
    send "{\"type\":\"output\",\"text\":\"  ($persist_count persistence vectors — no capability needed)\\n\"}"
  fi

  # Test 10: Process and system info
  send "{\"type\":\"output\",\"text\":\"\\n  ── System reconnaissance ──\\n\"}"
  if command -v ps &>/dev/null; then
    proc_count=$(ps aux 2>/dev/null | wc -l | tr -d ' ')
    send "{\"type\":\"output\",\"text\":\"  ps aux: $proc_count processes visible\\n\"}"
  fi
  send "{\"type\":\"output\",\"text\":\"  whoami: $(whoami 2>/dev/null || echo unknown)\\n\"}"
  send "{\"type\":\"output\",\"text\":\"  hostname: $(hostname 2>/dev/null || echo unknown)\\n\"}"
  if [ -n "$project_root" ]; then
    send "{\"type\":\"output\",\"text\":\"  user home: $HOME\\n\"}"
  fi

  # DNS exfiltration check (even if curl is blocked, DNS works)
  if command -v dig &>/dev/null || command -v nslookup &>/dev/null; then
    warn "DNS tools available — data can be exfiltrated via DNS queries even without curl"
  fi

  send "{\"type\":\"output\",\"text\":\"\\n  ── TAKEAWAY ──\\n\"}"
  send "{\"type\":\"output\",\"text\":\"  Capabilities gate the fledge-v1 RPC only. The plugin process itself\\n\"}"
  send "{\"type\":\"output\",\"text\":\"  is an unsandboxed subprocess with full user access.\\n\"}"
  send "{\"type\":\"output\",\"text\":\"  A malicious plugin needs ZERO capabilities to steal data.\\n\"}"

  # ── WASM Sandbox Contrast ──
  send "{\"type\":\"output\",\"text\":\"\\n  ── WASM SANDBOX CONTRAST ──\\n\"}"
  send "{\"type\":\"output\",\"text\":\"  A WASM plugin (runtime=\\\"wasm\\\") with the same code would see:\\n\\n\"}"

  send "{\"type\":\"output\",\"text\":\"  Filesystem (WASI preopens enforce boundaries):\\n\"}"
  if [ -r "$HOME/.ssh" ]; then
    send "{\"type\":\"output\",\"text\":\"    NATIVE: ~/.ssh/ READABLE            → WASM: BLOCKED (no preopened dir for ~)\\n\"}"
  fi
  if [ -r "$HOME/.config/fledge/config.toml" ]; then
    send "{\"type\":\"output\",\"text\":\"    NATIVE: ~/.config/fledge/ READABLE   → WASM: BLOCKED (outside sandbox)\\n\"}"
  fi
  if [ -r "$HOME/.aws/credentials" ]; then
    send "{\"type\":\"output\",\"text\":\"    NATIVE: ~/.aws/credentials READABLE  → WASM: BLOCKED (outside sandbox)\\n\"}"
  fi
  if [ -d ".git/hooks" ] && [ -w ".git/hooks" ]; then
    send "{\"type\":\"output\",\"text\":\"    NATIVE: .git/hooks/ WRITABLE         → WASM: BLOCKED (read-only or none)\\n\"}"
  fi

  send "{\"type\":\"output\",\"text\":\"\\n  Environment Variables (WASM guest has empty env):\\n\"}"
  wasm_contrast_vars="GITHUB_TOKEN GH_TOKEN OPENAI_API_KEY ANTHROPIC_API_KEY AWS_SECRET_ACCESS_KEY"
  for varname in $wasm_contrast_vars; do
    val="${!varname:-}"
    if [ -n "$val" ]; then
      send "{\"type\":\"output\",\"text\":\"    NATIVE: $varname LEAKED              → WASM: BLOCKED (not passed to guest)\\n\"}"
    fi
  done

  send "{\"type\":\"output\",\"text\":\"\\n  Network (imports not linked when network=false):\\n\"}"
  send "{\"type\":\"output\",\"text\":\"    NATIVE: curl/wget AVAILABLE          → WASM: BLOCKED (no socket imports)\\n\"}"
  send "{\"type\":\"output\",\"text\":\"    NATIVE: DNS exfil via dig AVAILABLE  → WASM: BLOCKED (no network API)\\n\"}"

  send "{\"type\":\"output\",\"text\":\"\\n  Process Spawning (WASI p1 has no spawn API):\\n\"}"
  send "{\"type\":\"output\",\"text\":\"    NATIVE: shell commands AVAILABLE     → WASM: BLOCKED (no process API)\\n\"}"
  send "{\"type\":\"output\",\"text\":\"    NATIVE: crontab AVAILABLE            → WASM: BLOCKED (cannot spawn)\\n\"}"

  send "{\"type\":\"output\",\"text\":\"\\n  Persistence (sandbox prevents all vectors):\\n\"}"
  send "{\"type\":\"output\",\"text\":\"    NATIVE: .git/hooks injection         → WASM: BLOCKED (no write access)\\n\"}"
  send "{\"type\":\"output\",\"text\":\"    NATIVE: shell RC backdoor            → WASM: BLOCKED (~ inaccessible)\\n\"}"
  send "{\"type\":\"output\",\"text\":\"    NATIVE: LaunchAgents daemon          → WASM: BLOCKED (filesystem sealed)\\n\"}"

  send "{\"type\":\"output\",\"text\":\"\\n  Enforcement is structural: missing WASI preopens = files don't exist,\\n\"}"
  send "{\"type\":\"output\",\"text\":\"  missing imports = functions can't be called. Not a runtime check.\\n\"}"
  send "{\"type\":\"output\",\"text\":\"  To verify: fledge canary-wasm (requires WASM canary installed)\\n\"}"
}

# ── Run selected sections ─────────────────────────────────────────────
case "$SECTION" in
  metadata) run_metadata_tests ;;
  exec)     run_exec_tests ;;
  store)    run_store_tests ;;
  expose)   run_exposure_report ;;
  baseline) run_baseline_tests ;;
  all)
    run_metadata_tests
    run_exec_tests
    run_store_tests
    # Always show baseline when all caps are denied
    if [ "$HAS_EXEC" != "true" ] && [ "$HAS_STORE" != "true" ] && [ "$HAS_METADATA" != "true" ]; then
      run_baseline_tests
    fi
    ;;
esac

# ── Summary ───────────────────────────────────────────────────────────
header "SUMMARY"
TOTAL=$((PASS + FAIL + WARN))
send "{\"type\":\"output\",\"text\":\"  $TOTAL tests: $PASS passed, $FAIL failed, $WARN warnings\\n\"}"

if [ "$FAIL" -gt 0 ]; then
  send "{\"type\":\"output\",\"text\":\"\\n  Failures indicate capability boundaries not enforced as expected.\\n\"}"
  send "{\"type\":\"output\",\"text\":\"  Review the FAIL items above and update security documentation.\\n\"}"
  exit 1
elif [ "$WARN" -gt 0 ]; then
  send "{\"type\":\"output\",\"text\":\"\\n  Warnings indicate expected-but-noteworthy behaviors.\\n\"}"
  send "{\"type\":\"output\",\"text\":\"  These should be documented so users understand the trust model.\\n\"}"
fi

send "{\"type\":\"output\",\"text\":\"\\n\"}"
exit 0
