#!/usr/bin/env bash
set -euo pipefail

# fledge-plugin-canary legacy mode
# Shows what a plugin's bash process can see WITHOUT using any RPC capabilities.
# This wraps output in fledge-v1 JSON so it actually renders.

send() { echo "{\"type\":\"output\",\"text\":\"$1\\n\"}"; }
recv() { read -r line; echo "$line"; }

# Read and discard the init message (required by protocol)
INIT=$(recv)

send "=== CANARY LEGACY MODE ==="
send "Shows what the plugin process inherits from the parent shell."
send "None of this requires any fledge-v1 capability grant."
send ""

send "=== FLEDGE-SET VARIABLES ==="
fledge_vars=$(env | grep -i "^FLEDGE_" | sort || true)
if [ -n "$fledge_vars" ]; then
  while IFS= read -r line; do
    varname=$(echo "$line" | cut -d= -f1)
    value=$(echo "$line" | cut -d= -f2-)
    send "  $varname=$value"
  done <<< "$fledge_vars"
else
  send "  (none)"
fi
send ""

send "=== SENSITIVE-LOOKING VARIABLES ==="
send "Patterns: TOKEN, SECRET, KEY, PASSWORD, CREDENTIAL, API:"
sensitive=$(env | grep -iE '(TOKEN|SECRET|KEY|PASSWORD|CREDENTIAL|API_)' | sort || true)
if [ -n "$sensitive" ]; then
  while IFS= read -r line; do
    varname=$(echo "$line" | cut -d= -f1)
    value=$(echo "$line" | cut -d= -f2-)
    if [ ${#value} -gt 4 ]; then
      masked="${value:0:4}***"
    else
      masked="****"
    fi
    send "  $varname=$masked"
  done <<< "$sensitive"
else
  send "  (none found)"
fi
send ""

send "=== ENVIRONMENT SUMMARY ==="
total=$(env | wc -l | tr -d ' ')
send "  Total env vars visible to process: $total"
send ""

send "=== FILESYSTEM ACCESS ==="
if [ -r "$HOME/.config/fledge/config.toml" ]; then
  token_count=$(grep -ciE '(token|secret|key|password)' "$HOME/.config/fledge/config.toml" 2>/dev/null || echo 0)
  send "  Global config (~/.config/fledge/config.toml): READABLE ($token_count sensitive lines)"
else
  send "  Global config (~/.config/fledge/config.toml): NOT READABLE"
fi

if [ -r "fledge.toml" ]; then
  send "  Project config (fledge.toml): READABLE"
else
  send "  Project config (fledge.toml): NOT READABLE"
fi
send ""

send "=== CONCLUSION ==="
send "The plugin process is an unsandboxed subprocess."
send "Capabilities only gate fledge-v1 RPC responses."
send "Direct bash access to files, env, and network is always available."
